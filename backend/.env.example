# postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transcendence

# backend
ENV=dev
PORT=8080
LOG_LEVEL=info
JWT_SECRET=dev-only-change-me

# uploads
# UPLOAD_DIR is for HOST tuns (`make run`); docker compose overrides it to /app/uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
MAX_IMAGES_PER_LISTING=5

# DB_URL is for tools you run on the HOST (e.g. `make migrate-up`), overridden inside Docker
DB_URL=postgres://postgres:postgres@localhost:5432/transcendence?sslmode=disable

# Tests only. Points at the maintenance database; each test creates and drops
# its own, so this must NEVER be the database you develop against.
TEST_DB_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# How long an access token stays valid. Short on purpose: a JWT cannot be
# revoked, so the refresh token is what ends a session. Any Go duration -
# 15m, 1h, 30s.
ACCESS_TOKEN_TTL=15m

# Whether the refresh cookie carries the Secure flag. Leave true anywhere real.
# Set false for local development only: a browser will not send a Secure cookie
# over plain http://localhost, so the refresh flow silently fails without it.
COOKIE_SECURE=true

# Requests per minute allowed per API key. Browser sessions are not limited.
RATE_LIMIT_PER_MINUTE=60
