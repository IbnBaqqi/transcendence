# Base used by the API client (axios) and the OAuth "Continue with Google/GitHub"
# buttons, so all three always point at the same place.
#
# Keep it SAME-SITE (a relative path including the /api/v1 segment, like the
# default). The session relies on cookies from the backend, and the refresh
# cookie is SameSite=Lax — it won't be sent on requests to a different-origin API
# base, so a cross-origin VITE_API_URL silently breaks both session refresh and
# OAuth sign-in links even though it looks valid.
VITE_API_URL=/api/v1
