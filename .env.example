# Copy to .env at the REPO ROOT: `cp .env.example .env`.
# docker compose reads this one, so it covers db + backend + frontend.
#
# backend/.env.example is a near-copy for running the backend on the host
# (`make run`, `make migrate-up`) without compose. Keep the two in sync.

# postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transcendence

# backend
ENV=dev
PORT=8080
LOG_LEVEL=info
JWT_SECRET=dev-only-change-me

# uploads
# UPLOAD_DIR is for HOST tuns (`make run`); docker compose overrides it to /app/uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
MAX_IMAGES_PER_LISTING=5

# DB_URL is for tools you run on the HOST (e.g. `make migrate-up`), overridden inside Docker
DB_URL=postgres://postgres:postgres@localhost:5432/transcendence?sslmode=disable

# Tests only, and read from backend/.env — `make test-db` includes that file,
# not this one. Inside compose the host is `db`, not localhost.
TEST_DB_URL=postgres://postgres:postgres@db:5432/postgres?sslmode=disable

# How long an access token stays valid. Short on purpose: a JWT cannot be
# revoked, so the refresh token is what ends a session. Any Go duration.
ACCESS_TOKEN_TTL=15m

# Whether the refresh cookie carries the Secure flag. Leave true anywhere real.
# False for local development: a browser will not send a Secure cookie to a
# plain http origin, so the refresh flow silently fails without it.
COOKIE_SECURE=false

# Requests per minute allowed per API key. Browser sessions are not limited.
RATE_LIMIT_PER_MINUTE=60

# Frontend-only var (lives in frontend/.env.example), noted here so it's not
# forgotten at the repo level. Set it in the FRONTEND env, not this file. It is
# the base for the API client and the OAuth sign-in buttons, and must be the
# relative path form INCLUDING the /api/v1 segment:
#   VITE_API_URL=/api/v1
# A bare origin would point both the API calls and the OAuth links at the wrong
# place.

# OAuth (optional) - leave empty and the provider's endpoints answer 404.
# Register the callback with the provider exactly as it appears here:
#   http://localhost:8080/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the provider redirects back to, and where we send the browser after.
# These two must share a site (same registrable domain): the session cookie is
# SameSite=Lax, so a frontend on an unrelated domain never gets it back and the
# sign-in appears to succeed but leaves the user logged out.
PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
# Mail. Leave SMTP_HOST empty and notifications are logged instead of sent.
# `docker compose up` starts Mailpit: nothing leaves your machine, and you read
# what was "sent" at http://localhost:8025. The host is the compose service
# name - localhost inside the backend container is the backend itself.
SMTP_HOST=mailpit
SMTP_PORT=1025

# Empty against Mailpit, which offers no AUTH extension: sending credentials to
# a server that does not advertise it fails the handshake.
SMTP_USERNAME=
SMTP_PASSWORD=

# The address recipients see. Must be set, or mail is treated as unconfigured.
MAIL_FROM=no-reply@forage.local
